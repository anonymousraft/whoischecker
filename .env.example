# Carbon Intelligence - Environment Configuration
# Copy this file to .env and adjust values as needed

# ===========================================
# APPLICATION
# ===========================================
APP_NAME="Carbon Intelligence"
APP_ENV=production
APP_DEBUG=false

# ===========================================
# BULK PROCESSING
# ===========================================
# Maximum domains allowed per bulk upload
BULK_DOMAIN_LIMIT=5000

# Delay between WHOIS requests in milliseconds (prevents rate limiting)
BULK_RATE_DELAY=250

# ===========================================
# WHOIS SETTINGS
# ===========================================
# Timeout for WHOIS queries in seconds
WHOIS_TIMEOUT=10

# ===========================================
# DNS SETTINGS
# ===========================================
# Timeout for DNS queries in seconds
DNS_TIMEOUT=10

# DNS provider: cloudflare or google
DNS_PROVIDER=cloudflare
